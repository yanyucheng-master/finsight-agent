# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交或外发密钥）。推荐直接运行 scripts\setup_env.bat 生成。
# 当前生效的大模型供应商：deepseek（低成本测试）/ kimi（参赛）/ intern（书生）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
KIMI_API_KEY=
INTERN_API_KEY=
# 以下均为可选项（不填则用默认值）
# 模型名，默认 deepseek-flash / kimi-k3.1-pro，以各家官方文档为准
# LLM_MODEL=
# 推理强度：none（仅 DeepSeek 可关闭思考）/ low（默认）/ high / max
# LLM_REASONING_EFFORT=low
# 单次输出上限（思考内容也计入），默认 DeepSeek 16384、Kimi 32768
# LLM_MAX_TOKENS=
# 单次请求超时秒数，默认 300
# LLM_TIMEOUT_S=300
# 数据模式：snapshot = 只读本地快照（默认，可离线复现）
FINSIGHT_PROVIDER=snapshot
