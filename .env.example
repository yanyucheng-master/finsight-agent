# 复制为 .env 后填写（.env 已被 .gitignore 忽略，切勿提交或外发密钥）。
# 当前生效的大模型（OpenAI 兼容接口），模型名以各家官方文档为准。
# 低成本测试：DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
# 备选：Kimi（Moonshot）  LLM_BASE_URL=https://api.moonshot.cn/v1
KIMI_API_KEY=
# 若参加“书生”赛题，参赛主模型须为书生大模型（API 平台：internlm.intern-ai.org.cn）
INTERN_API_KEY=
# 数据模式：snapshot = 只读本地快照（默认，可离线复现）
FINSIGHT_PROVIDER=snapshot
